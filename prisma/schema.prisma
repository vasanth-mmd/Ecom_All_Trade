// Prisma schema for the Trade FR Dashboard auth database.
// Works with any Postgres host (Neon, Supabase, Vercel Postgres, Railway, etc).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
}

model Dataset {
  id        Int      @id
  json      String
  updatedAt DateTime @updatedAt
}
