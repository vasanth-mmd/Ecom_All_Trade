# Postgres connection string. Works with Neon, Supabase, Vercel Postgres, Railway, etc.
DATABASE_URL="postgresql://user:password@host:5432/dbname?sslmode=require"

# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET="replace-with-a-long-random-string"

# The deployed URL of your app. For local dev: http://localhost:3000
NEXTAUTH_URL="http://localhost:3000"

# Passcode required to upload a new data file on the Upload Data page (admin only)
ADMIN_PASSCODE=""

# ---------------------------------------------------------------
# JARVIS AI ENGINES
# At least one key is required. Claude is the recommended primary
# engine for the forecasting work; the others act as backup and can
# be picked manually from the Engine switcher on the Jarvis page.
# Either capitalisation works (ANTHROPIC_API_KEY or Anthropic_API_KEY).
# ---------------------------------------------------------------
# Claude  - console.anthropic.com -> API Keys
ANTHROPIC_API_KEY=""

# GPT     - platform.openai.com -> API Keys
OpenAI_API_KEY=""

# Gemini  - aistudio.google.com -> Get API key
Gemini_API_KEY=""

# Which engine Jarvis uses by default: anthropic | openai | gemini
AI_PROVIDER="anthropic"

# Optional model overrides (leave blank to use the built-in defaults,
# which fall back automatically if a model id is retired)
# AI_MODEL_ANTHROPIC="claude-sonnet-5"
# AI_MODEL_OPENAI="gpt-5.6"
# AI_MODEL_GEMINI="gemini-3.5-flash"

# ---------------------------------------------------------------
# Daily FR report email (resend.com -> API Keys)
# ---------------------------------------------------------------
RESEND_API_KEY=""

# Comma-separated list of recipient emails. Defaults to vasanth@milkymist.com if unset.
REPORT_RECIPIENTS="vasanth@milkymist.com"

# Optional: set this on Vercel too. Vercel auto-sends it as a Bearer token
# when invoking the Cron Job, so /api/reports/daily can verify the caller.
# Generate with: openssl rand -base64 32
CRON_SECRET=""
